# =============================================================================
# FloodGuard environment variables (D-05)
#
# Copy to `.env.local` (gitignored) and edit. Nothing here is required to run
# the demo: the web app is fully functional with no backend and no variables
# set. That is deliberate (ADR-H) -- and it is also the trap this file exists
# to document, because a misconfigured deployment produces a plausible-looking
# STALE UI rather than an error.
#
# NEVER commit real values for anything marked SECRET.
# =============================================================================


# -----------------------------------------------------------------------------
# Web application (apps/web)
#
# NEXT_PUBLIC_* are inlined into the client bundle at BUILD time and are
# readable by anyone. Never put a secret in one.
# -----------------------------------------------------------------------------

# Base URL of the FastAPI service.
#
# UNSET (the default, and what the deployed build uses) -> the app silently
# falls back to the offline bundles committed under
# apps/web/public/offline-demo/ and reports data_state=stale.
#
# This fallback is a feature for a crisis tool and a hazard for a deployment:
# if you set this to a wrong or unreachable URL, users see stale data with no
# error. Set it deliberately, or leave it unset deliberately.
NEXT_PUBLIC_FLOODGUARD_API_URL=

# competition | public-production
#
# `public-production` PHYSICALLY REMOVES the /command and /studio routes at
# build time (apps/web/scripts/build-profile.mjs) -- they are absent from the
# output, not merely hidden. Defaults to `competition`.
NEXT_PUBLIC_FLOODGUARD_APP_PROFILE=competition

# Build-time equivalent of the above, read by the build scripts themselves.
FLOODGUARD_APP_PROFILE=competition


# -----------------------------------------------------------------------------
# API service (services/api) -- only needed if you actually run the API
# -----------------------------------------------------------------------------

# Comma-separated allowed CORS origins, e.g.
#   https://floodguard.example.org,https://staging.floodguard.example.org
# Unset -> http://localhost:3000 and http://127.0.0.1:3000 only.
# Values must be HTTP(S) origins; the app rejects anything else at startup.
FLOODGUARD_CORS_ORIGINS=

# SECRET. JSON map of pilot HMAC credentials used to authenticate staff API
# routes. No endpoint issues these; they are minted out of band.
# There is no user-facing login anywhere in the product (ADR: I-1).
FLOODGUARD_PILOT_KEYS_JSON=

# Which key id in the map above is currently active.
FLOODGUARD_PILOT_ACTIVE_KEY_ID=

# Pilot audit ledger: append-only, hash-chained.
# Writer mode `single_process` is required when more than one worker could
# write concurrently.
FLOODGUARD_PILOT_AUDIT_LOG=
FLOODGUARD_PILOT_AUDIT_ANCHOR=
FLOODGUARD_PILOT_AUDIT_WRITER_MODE=

# Pilot artifact locations and receipts.
FLOODGUARD_PILOT_ARTIFACT_ROOT=
FLOODGUARD_MAE_SAI_PILOT_ROOT=
FLOODGUARD_PILOT_ACCEPTANCE_RECEIPT=
FLOODGUARD_PILOT_RETENTION_CATALOG=
FLOODGUARD_PILOT_CURRENT_ARTIFACT_MANIFEST=
FLOODGUARD_PILOT_CURRENT_FIELD_VALIDATION_RECEIPT=


# -----------------------------------------------------------------------------
# Governance signing keys -- SECRET
# -----------------------------------------------------------------------------

# SECRET. Hex HMAC key (>= 32 bytes) binding model output to a signed receipt.
#
# Used by BOTH zonal lanes:
#   - trusted_zonal_adapter        operational tier, cleared official inputs
#   - candidate_zonal_receipt      report-only tier, GeoAI candidate evidence
#
# `run_real` FAILS CLOSED without it. That is deliberate: the FPPS values and
# A-E action classes it produces are published to the Command surface, and
# emitting them with no receipt is the exact failure D-02 exists to prevent.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# The key is used in memory only and never appears in a receipt.
FLOODGUARD_ZONAL_SIGNING_KEY_HEX=

# Identifier recorded in the receipt's signature block so a verifier knows
# which key to check against. Not a secret. Defaults to "candidate-local".
FLOODGUARD_ZONAL_SIGNING_KEY_ID=

# Consequence-record signing key and its id.
FLOODGUARD_CONSEQUENCE_SIGNING_KEY=
FLOODGUARD_CONSEQUENCE_SIGNING_KEY_ID=


# -----------------------------------------------------------------------------
# GeoAI runner (services/geoai-runner)
# -----------------------------------------------------------------------------

# Opt-in gate for the GeoAI smoke test. Requires the isolated `geoai` extra to
# be installed; the normal CI job asserts the library is ABSENT, so this is
# never set there. See services/geoai-runner/README.md.
RUN_GEOAI_SMOKE=

# Proof metadata recorded alongside a smoke run.
FLOODGUARD_PROOF_COMMIT=
GEOAI_PROOF_OUTPUT_DIR=

# Comma-separated status filters applied when aggregating / validating GeoAI
# component results.
GEOAI_AGGREGATION_STATUSES=
GEOAI_VALIDATION_STATUSES=

# Path to a QGIS binary, for the manual reference-mask workflow.
FLOODGUARD_QGIS_BIN=


# -----------------------------------------------------------------------------
# Test and smoke harness -- not used in production
# -----------------------------------------------------------------------------

# Targets for the live API and browser smokes.
FLOODGUARD_API_URL=
FLOODGUARD_WEB_URL=
FLOODGUARD_SMOKE_TIMEOUT_MS=

# Absolute path to a Chromium/Chrome binary for Playwright. Machine-specific;
# never commit a real value.
FLOODGUARD_BROWSER_EXECUTABLE=

# Output directories for the deployment-profile verification scripts.
FLOODGUARD_PROFILE_OUT=
FLOODGUARD_COMPETITION_PROFILE_OUT=
FLOODGUARD_PUBLIC_PROFILE_OUT=

# TEST FIXTURE ONLY -- not a production secret. tests/test_model_promotion.py
# supplies its own value; this is listed so nobody mistakes it for one.
FLOODGUARD_TEST_PROMOTION_KEY=

# Determinism helpers for notebook/orientation report generation.
FLOODGUARD_NOTEBOOK_EXECUTED_AT_UTC=
FLOODGUARD_ORIENTATION_DIR=
FLOODGUARD_PRACTICE_ASSESSMENT_DIR=
FLOODGUARD_CACHE_READY=
