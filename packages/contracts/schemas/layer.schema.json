{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodguard.th/contracts/layer.schema.json",
  "title": "FloodGuard layer catalog item",
  "description": "A sanitized, role-scoped geospatial layer reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_mode",
    "operational_status",
    "source_timestamp",
    "generated_at",
    "confidence_class",
    "source_name",
    "assumptions",
    "official_warning",
    "data_version",
    "git_commit",
    "layer_id",
    "title_th",
    "title_en",
    "role_visibility",
    "format",
    "url",
    "data_state",
    "model_run_id",
    "attribution"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "dataset_mode": {
      "type": "string",
      "enum": ["fixture_demo", "candidate", "official_input"]
    },
    "operational_status": {
      "type": "string",
      "enum": ["non_operational", "planning_only", "agency_operational"]
    },
    "source_timestamp": { "type": "string", "format": "date-time" },
    "generated_at": { "type": "string", "format": "date-time" },
    "confidence_class": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "source_name": { "type": "string", "minLength": 1 },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "official_warning": { "type": "boolean" },
    "data_version": { "type": "string", "minLength": 1 },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,40}$"
    },
    "layer_id": { "type": "string", "minLength": 1 },
    "title_th": { "type": "string", "minLength": 1 },
    "title_en": { "type": "string", "minLength": 1 },
    "role_visibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["public", "command", "studio"]
      }
    },
    "format": {
      "type": "string",
      "enum": ["geojson", "cog", "pmtiles"]
    },
    "url": { "type": "string", "format": "uri-reference", "minLength": 1 },
    "data_state": {
      "type": "string",
      "enum": ["ready", "stale", "blocked", "unavailable"]
    },
    "model_run_id": { "type": ["string", "null"], "minLength": 1 },
    "attribution": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dataset_mode": { "enum": ["fixture_demo", "candidate"] }
        },
        "required": ["dataset_mode"]
      },
      "then": {
        "properties": { "official_warning": { "const": false } }
      }
    }
  ]
}
