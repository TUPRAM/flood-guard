{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodguard.th/contracts/proposal-evidence.schema.json",
  "title": "FloodGuard proposal evidence manifest",
  "description": "A public, path-redacted receipt that connects proposal claims to reviewable artifacts and test evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "git_commit",
    "dataset_mode",
    "operational_status",
    "artifacts",
    "test_suites",
    "geoai_proof"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "dataset_mode": {
      "type": "string",
      "enum": ["fixture_demo", "candidate", "official_input"]
    },
    "operational_status": {
      "type": "string",
      "enum": ["non_operational", "planning_only", "agency_operational"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "relative_path", "media_type", "sha256"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!\\\\\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "media_type": {
            "type": "string",
            "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "test_suites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "result", "passed", "skipped"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "result": {
            "type": "string",
            "enum": ["not_run", "passed", "failed"]
          },
          "passed": { "type": "integer", "minimum": 0 },
          "skipped": { "type": "integer", "minimum": 0 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "result": { "const": "not_run" } },
              "required": ["result"]
            },
            "then": {
              "properties": {
                "passed": { "const": 0 },
                "skipped": { "const": 0 }
              }
            }
          },
          {
            "if": {
              "properties": { "result": { "const": "passed" } },
              "required": ["result"]
            },
            "then": { "properties": { "passed": { "minimum": 1 } } }
          }
        ]
      }
    },
    "geoai_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geoai_version",
        "feature_stack_id",
        "preprocessing_id",
        "input_manifest_sha256",
        "output_probability_sha256",
        "validation_status",
        "aggregation_status",
        "processing_allowed",
        "can_feed_decision_layer",
        "reason_blocked"
      ],
      "properties": {
        "geoai_version": { "const": "0.41.1" },
        "feature_stack_id": { "type": "string", "minLength": 1 },
        "preprocessing_id": { "type": "string", "minLength": 1 },
        "input_manifest_sha256": { "$ref": "#/$defs/nullableSha256" },
        "output_probability_sha256": { "$ref": "#/$defs/nullableSha256" },
        "validation_status": {
          "type": "string",
          "enum": ["not_run", "passed", "failed", "blocked"]
        },
        "aggregation_status": {
          "type": "string",
          "enum": ["not_run", "passed", "report_only", "failed", "blocked"]
        },
        "processing_allowed": { "type": "boolean" },
        "can_feed_decision_layer": { "type": "boolean" },
        "reason_blocked": { "type": "string" }
      }
    }
  },
  "$defs": {
    "nullableSha256": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dataset_mode": { "enum": ["fixture_demo", "candidate"] }
        },
        "required": ["dataset_mode"]
      },
      "then": {
        "properties": {
          "operational_status": { "const": "non_operational" },
          "geoai_proof": {
            "properties": { "can_feed_decision_layer": { "const": false } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "geoai_proof": {
            "properties": { "processing_allowed": { "const": false } },
            "required": ["processing_allowed"]
          }
        },
        "required": ["geoai_proof"]
      },
      "then": {
        "properties": {
          "geoai_proof": {
            "properties": { "can_feed_decision_layer": { "const": false } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "geoai_proof": {
            "properties": { "can_feed_decision_layer": { "const": false } },
            "required": ["can_feed_decision_layer"]
          }
        },
        "required": ["geoai_proof"]
      },
      "then": {
        "properties": {
          "geoai_proof": {
            "properties": { "reason_blocked": { "minLength": 1 } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "geoai_proof": {
            "properties": { "can_feed_decision_layer": { "const": true } },
            "required": ["can_feed_decision_layer"]
          }
        },
        "required": ["geoai_proof"]
      },
      "then": {
        "properties": {
          "dataset_mode": { "const": "official_input" },
          "operational_status": {
            "enum": ["planning_only", "agency_operational"]
          },
          "geoai_proof": {
            "properties": {
              "input_manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "output_probability_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "validation_status": { "const": "passed" },
              "aggregation_status": { "const": "passed" },
              "processing_allowed": { "const": true },
              "reason_blocked": { "maxLength": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "geoai_proof": {
            "properties": { "validation_status": { "const": "passed" } },
            "required": ["validation_status"]
          }
        },
        "required": ["geoai_proof"]
      },
      "then": {
        "properties": {
          "geoai_proof": {
            "properties": {
              "input_manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "output_probability_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}
