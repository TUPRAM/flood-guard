{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodguard.th/schemas/evidence-library-catalog.schema.json",
  "title": "evidence-library-catalog",
  "x-contract-version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "non_operational": {
      "const": true
    },
    "aois": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "name_th": {
            "type": "string"
          },
          "geometry": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "Point",
                  "MultiPoint",
                  "LineString",
                  "MultiLineString",
                  "Polygon",
                  "MultiPolygon",
                  "GeometryCollection"
                ]
              },
              "coordinates": {
                "type": "array"
              },
              "geometries": {
                "type": "array"
              }
            },
            "additionalProperties": false
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "name",
          "geometry",
          "event_ids"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "name_th": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "minLength": 1
          },
          "end": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "start",
          "end"
        ]
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "title_th": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            }
          },
          "temporal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "end": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "start",
              "end",
              "kind",
              "label"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "public_derivatives": {
                "type": "boolean"
              },
              "attribution": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "status",
              "license",
              "public_derivatives",
              "attribution"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "role",
          "source_urls",
          "temporal",
          "limitations",
          "rights"
        ]
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "aoi_id": {
            "type": "string",
            "minLength": 1
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^/evidence-library/[A-Za-z0-9_/-]+\\.(json|geojson|md|html|txt|csv|pdf|png|webp)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "aoi_id",
          "event_id",
          "url",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "package_version",
    "non_operational",
    "aois",
    "events",
    "datasets",
    "packages"
  ]
}
