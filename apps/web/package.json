{
  "name": "@floodguard/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:competition": "node scripts/build-profile.mjs competition",
    "build:public": "node scripts/build-profile.mjs public-production",
    "test:profile": "node scripts/profile-artifact-smoke.mjs competition",
    "test:public-profile": "node scripts/browser-public-profile-smoke.mjs",
    "verify:profiles": "node scripts/verify-deployment-profiles.mjs",
    "postbuild": "node scripts/write-offline-assets.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:offline": "node scripts/offline-smoke.mjs && node scripts/browser-offline-smoke.mjs",
    "test:evidence-assets": "node --test scripts/evidence-library-assets.test.mjs scripts/evidence-gzip-json-audit.test.mjs",
    "test:evidence-browser": "node scripts/browser-evidence-library-smoke.mjs",
    "test:csp": "node scripts/csp-smoke.mjs",
    "test:live-api": "node scripts/live-api-smoke.mjs",
    "qa:visual": "node scripts/capture-visual-qa.mjs",
    "qa:landing": "node scripts/landing-smoke.mjs",
    "qa:desktop": "node scripts/desktop-landing-smoke.mjs",
    "art:desktop": "node scripts/render-drone-assets.mjs",
    "art:landing": "node scripts/render-landing-assets.mjs"
  },
  "dependencies": {
    "@floodguard/contracts": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@gsap/react": "2.1.2",
    "@react-three/fiber": "9.4.0",
    "gsap": "3.13.0",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.61.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.10.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.5",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}
