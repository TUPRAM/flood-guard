              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "source_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "format": "uri"
                }
              }
            },
            "required": [
              "topic",
              "status",
              "summary",
              "source_urls"
