          }
        },
        "capacity_experiments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "participation_fraction": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "assumed_demand": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "assigned": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
