                "minLength": 1
              },
              "scenario_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "add_destination",
                  "close_edge",
                  "remove_destination"
                ]
              },
              "gaining_30_min_access": {
                "type": "number",
                "minimum": 0
              },
              "losing_30_min_access": {
                "type": "number",
                "minimum": 0
              },
              "slower_population": {
                "type": "number",
                "minimum": 0
              },
              "faster_population": {
                "type": "number",
                "minimum": 0
              },
              "comparable_population": {
                "type": "number",
                "minimum": 0
              },
              "mean_travel_time_delta_minutes": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "result": {
                "enum": [
                  "threshold_change",
                  "travel_time_only",
                  "no_measured_change"
                ]
              },
              "observed": {
                "const": false
              },
              "selection_method": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "scenario_id",
              "kind",
              "gaining_30_min_access",
              "losing_30_min_access",
              "slower_population",
              "faster_population",
              "comparable_population",
              "mean_travel_time_delta_minutes",
              "result",
              "observed"
            ]
          }
        },
        "capacity_status": {
