{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodguard.th/contracts/area-decision.schema.json",
  "title": "FloodGuard area decision",
  "description": "One reporting area's decision-support record. Producers must verify fpps_0_100 against the locked 30/25/20/15/10 weights and action_class against the existing A-E rules; the FastAPI boundary enforces both relationships.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_mode",
    "operational_status",
    "source_timestamp",
    "generated_at",
    "confidence_class",
    "source_name",
    "assumptions",
    "official_warning",
    "data_version",
    "git_commit",
    "evidence_context_id",
    "area_id",
    "area_name_th",
    "area_name_en",
    "fpps_0_100",
    "action_class",
    "action_reason_code",
    "top_reason",
    "flood_likelihood_0_100",
    "exposure_0_100",
    "access_gap_0_100",
    "road_criticality_0_100",
    "vulnerability_context_0_100",
    "people_losing_30_min_access",
    "equity_gap_ratio"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "dataset_mode": {
      "type": "string",
      "enum": ["fixture_demo", "candidate", "official_input"]
    },
    "operational_status": {
      "type": "string",
      "enum": ["non_operational", "planning_only", "agency_operational"]
    },
    "source_timestamp": { "type": "string", "format": "date-time" },
    "generated_at": { "type": "string", "format": "date-time" },
    "confidence_class": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "source_name": { "type": "string", "minLength": 1 },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "official_warning": { "type": "boolean" },
    "data_version": { "type": "string", "minLength": 1 },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,40}$"
    },
    "evidence_context_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "area_id": { "type": "string", "minLength": 1 },
    "area_name_th": { "type": "string", "minLength": 1 },
    "area_name_en": { "type": "string", "minLength": 1 },
    "fpps_0_100": { "type": "number", "minimum": 0, "maximum": 100 },
    "action_class": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E"]
    },
    "action_reason_code": {
      "type": "string",
      "enum": [
        "low_confidence",
        "low_priority_score",
        "life_safety_exposure",
        "critical_route_access",
        "essential_service_access",
        "resilience"
      ]
    },
    "top_reason": { "type": "string", "minLength": 1 },
    "flood_likelihood_0_100": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "exposure_0_100": { "type": "number", "minimum": 0, "maximum": 100 },
    "access_gap_0_100": { "type": "number", "minimum": 0, "maximum": 100 },
    "road_criticality_0_100": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "vulnerability_context_0_100": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "people_losing_30_min_access": { "type": "integer", "minimum": 0 },
    "equity_gap_ratio": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "road_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_risk_segments", "bridge_count", "summary"],
      "properties": {
        "at_risk_segments": { "type": "integer", "minimum": 0 },
        "bridge_count": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "facility_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facility_count", "summary"],
      "properties": {
        "facility_count": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "scenario_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "fpps_delta", "access_loss_delta"],
      "properties": {
        "scenario_id": { "type": "string", "minLength": 1 },
        "fpps_delta": { "type": "number", "minimum": -100, "maximum": 100 },
        "access_loss_delta": { "type": "integer" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dataset_mode": { "enum": ["fixture_demo", "candidate"] }
        },
        "required": ["dataset_mode"]
      },
      "then": {
        "properties": { "official_warning": { "const": false } }
      }
    }
  ]
}
