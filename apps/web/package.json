{
  "name": "@floodguard/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:competition": "node scripts/build-profile.mjs competition",
    "build:public": "node scripts/build-profile.mjs public-production",
    "test:profile": "node scripts/profile-artifact-smoke.mjs competition",
    "test:public-profile": "node scripts/browser-public-profile-smoke.mjs",
    "verify:profiles": "node scripts/verify-deployment-profiles.mjs",
    "postbuild": "node scripts/write-offline-assets.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:offline": "node scripts/offline-smoke.mjs && node scripts/browser-offline-smoke.mjs",
    "test:live-api": "node scripts/live-api-smoke.mjs",
    "qa:visual": "node scripts/capture-visual-qa.mjs"
  },
  "dependencies": {
    "@floodguard/contracts": "workspace:*",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "leaflet": "1.9.4",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.10.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.6",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  }
}
