{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodguard.th/contracts/qualified-evidence-foundation-v1.schema.json",
  "title": "FloodGuard qualified-evidence foundation status v1",
  "description": "A non-authoritative, fail-closed projection of the P0 qualified Thai reference and frozen label release milestone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "foundation_id",
    "study_area_id",
    "source_timestamp",
    "generated_at",
    "confidence_class",
    "status",
    "authoritative_receipt",
    "reference_candidate_binding",
    "stages",
    "permissions",
    "blockers",
    "next_actions",
    "assumptions",
    "safety",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "floodguard.qualified-evidence-foundation.v1"
    },
    "foundation_id": {
      "const": "qualified-thai-reference-frozen-label-release-v1"
    },
    "study_area_id": {
      "const": "mae_sai_candidate_v1"
    },
    "source_timestamp": {
      "$ref": "#/$defs/timestamp"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "confidence_class": {
      "const": "low"
    },
    "status": {
      "const": "blocked"
    },
    "authoritative_receipt": {
      "const": false
    },
    "reference_candidate_binding": {
      "$ref": "#/$defs/referenceCandidateBinding"
    },
    "stages": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/engineeringStage"
        },
        {
          "$ref": "#/$defs/referenceStage"
        },
        {
          "$ref": "#/$defs/calibrationStage"
        },
        {
          "$ref": "#/$defs/reviewStage"
        },
        {
          "$ref": "#/$defs/releaseStage"
        }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_processing_allowed",
        "source_processing_scope_en",
        "source_processing_scope_th",
        "experiment_processing_allowed",
        "qualified_reference_use_allowed",
        "training_allowed",
        "evaluation_allowed",
        "decision_layer_allowed",
        "operational_use_allowed"
      ],
      "properties": {
        "source_processing_allowed": {
          "const": true
        },
        "source_processing_scope_en": {
          "$ref": "#/$defs/nonempty"
        },
        "source_processing_scope_th": {
          "$ref": "#/$defs/nonempty"
        },
        "experiment_processing_allowed": {
          "const": false
        },
        "qualified_reference_use_allowed": {
          "const": false
        },
        "training_allowed": {
          "const": false
        },
        "evaluation_allowed": {
          "const": false
        },
        "decision_layer_allowed": {
          "const": false
        },
        "operational_use_allowed": {
          "const": false
        }
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nextAction"
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_warning",
        "operational_authorized",
        "can_feed_decision_layer",
        "can_feed_fpps",
        "can_assign_action_class"
      ],
      "properties": {
        "official_warning": {
          "const": false
        },
        "operational_authorized": {
          "const": false
        },
        "can_feed_decision_layer": {
          "const": false
        },
        "can_feed_fpps": {
          "const": false
        },
        "can_assign_action_class": {
          "const": false
        }
      }
    },
    "canonical_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "localizedStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "state",
        "label_en",
        "label_th",
        "detail_en",
        "detail_th"
      ],
      "properties": {
        "stage_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "ready",
            "blocked",
            "absent"
          ]
        },
        "label_en": {
          "$ref": "#/$defs/nonempty"
        },
        "label_th": {
          "$ref": "#/$defs/nonempty"
        },
        "detail_en": {
          "$ref": "#/$defs/nonempty"
        },
        "detail_th": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "referenceCandidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_schema",
        "product_id",
        "provider",
        "observation_start_utc",
        "observation_end_utc",
        "manifest_canonical_sha256",
        "manifest_file_sha256",
        "source_archive_sha256",
        "qualification_status",
        "processing_allowed"
      ],
      "properties": {
        "manifest_schema": {
          "const": "floodguard.reference_candidate_manifest.v1"
        },
        "product_id": {
          "const": "AIT-VAP001-TH"
        },
        "provider": {
          "const": "Asian Institute of Technology via Sentinel Asia"
        },
        "observation_start_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "observation_end_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "manifest_canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "qualification_status": {
          "const": "blocked_external_permission_and_scientific_review"
        },
        "processing_allowed": {
          "const": false
        }
      }
    },
    "engineeringStage": {
      "allOf": [
        {
          "$ref": "#/$defs/localizedStage"
        },
        {
          "properties": {
            "stage_id": {
              "const": "engineering_foundation"
            },
            "state": {
              "const": "ready"
            }
          }
        }
      ]
    },
    "referenceStage": {
      "allOf": [
        {
          "$ref": "#/$defs/localizedStage"
        },
        {
          "properties": {
            "stage_id": {
              "const": "qualified_thai_reference"
            },
            "state": {
              "const": "blocked"
            }
          }
        }
      ]
    },
    "calibrationStage": {
      "allOf": [
        {
          "$ref": "#/$defs/localizedStage"
        },
        {
          "properties": {
            "stage_id": {
              "const": "reviewer_calibration"
            },
            "state": {
              "const": "blocked"
            }
          }
        }
      ]
    },
    "reviewStage": {
      "allOf": [
        {
          "$ref": "#/$defs/localizedStage"
        },
        {
          "properties": {
            "stage_id": {
              "const": "blind_review_adjudication"
            },
            "state": {
              "const": "blocked"
            }
          }
        }
      ]
    },
    "releaseStage": {
      "allOf": [
        {
          "$ref": "#/$defs/localizedStage"
        },
        {
          "properties": {
            "stage_id": {
              "const": "frozen_label_release"
            },
            "state": {
              "const": "absent"
            }
          }
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail_en",
        "detail_th"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "detail_en": {
          "$ref": "#/$defs/nonempty"
        },
        "detail_th": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "action_en",
        "action_th"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "action_en": {
          "$ref": "#/$defs/nonempty"
        },
        "action_th": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_en",
        "assumption_th"
      ],
      "properties": {
        "assumption_en": {
          "$ref": "#/$defs/nonempty"
        },
        "assumption_th": {
          "$ref": "#/$defs/nonempty"
        }
      }
    }
  }
}
