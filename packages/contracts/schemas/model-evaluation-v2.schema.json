{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodguard.th/contracts/model-evaluation-v2.schema.json",
  "title": "FloodGuard model evaluation v2",
  "description": "A report-only projection of signed controlled-evaluation evidence. It contains no promotion thresholds and cannot itself authorize decision use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_mode",
    "operational_status",
    "source_timestamp",
    "generated_at",
    "confidence_class",
    "source_name",
    "assumptions",
    "official_warning",
    "data_version",
    "git_commit",
    "evaluation_id",
    "experiment_id",
    "study_area_id",
    "event_ids",
    "model_run_id",
    "model_id",
    "model_sha256",
    "model_run_manifest_sha256",
    "controlled_result_receipt_sha256",
    "evaluation_status",
    "evaluation_scope",
    "reference_evidence",
    "partition_evidence",
    "threshold_evidence",
    "overall_metrics",
    "event_metrics",
    "error_strata",
    "calibration",
    "selective_prediction",
    "ood_evaluation",
    "downstream_impact",
    "runtime",
    "processing_allowed",
    "can_feed_decision_layer",
    "reason_blocked"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "dataset_mode": {
      "enum": ["fixture_demo", "candidate", "official_input"]
    },
    "operational_status": {
      "enum": ["non_operational", "planning_only", "agency_operational"]
    },
    "source_timestamp": { "type": "string", "format": "date-time" },
    "generated_at": { "type": "string", "format": "date-time" },
    "confidence_class": { "enum": ["low", "medium", "high"] },
    "source_name": { "type": "string", "minLength": 1 },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "official_warning": { "const": false },
    "data_version": { "$ref": "#/$defs/safeId" },
    "git_commit": { "$ref": "#/$defs/commit" },
    "evaluation_id": { "$ref": "#/$defs/safeId" },
    "experiment_id": { "$ref": "#/$defs/safeId" },
    "study_area_id": { "$ref": "#/$defs/safeId" },
    "event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "model_run_id": { "$ref": "#/$defs/safeId" },
    "model_id": { "$ref": "#/$defs/safeId" },
    "model_sha256": { "$ref": "#/$defs/sha256" },
    "model_run_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "controlled_result_receipt_sha256": { "$ref": "#/$defs/nullableSha256" },
    "evaluation_status": {
      "enum": ["blocked", "completed_report_only", "failed"]
    },
    "evaluation_scope": {
      "enum": ["not_evaluated", "final_holdout"]
    },
    "reference_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_mask_status",
        "reference_mask_sha256",
        "label_release_sha256",
        "reviewer_qualification_receipt_sha256"
      ],
      "properties": {
        "reference_mask_status": {
          "enum": [
            "blocked",
            "synthetic_fixture_only",
            "qualified_expert_or_adjudicated",
            "confirmed_for_model_purpose"
          ]
        },
        "reference_mask_sha256": { "$ref": "#/$defs/nullableSha256" },
        "label_release_sha256": { "$ref": "#/$defs/nullableSha256" },
        "reviewer_qualification_receipt_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "partition_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_manifest_sha256",
        "training_partition_sha256",
        "calibration_partition_sha256",
        "final_holdout_partition_sha256"
      ],
      "properties": {
        "partition_manifest_sha256": { "$ref": "#/$defs/nullableSha256" },
        "training_partition_sha256": { "$ref": "#/$defs/nullableSha256" },
        "calibration_partition_sha256": { "$ref": "#/$defs/nullableSha256" },
        "final_holdout_partition_sha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "threshold_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold",
        "threshold_selection_receipt_sha256",
        "selection_scope",
        "final_holdout_evaluated_during_selection"
      ],
      "properties": {
        "threshold": { "$ref": "#/$defs/nullableUnitMetric" },
        "threshold_selection_receipt_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "selection_scope": {
          "enum": ["not_selected", "verified_calibration_projection_only"]
        },
        "final_holdout_evaluated_during_selection": { "type": "boolean" }
      }
    },
    "overall_metrics": { "$ref": "#/$defs/metrics" },
    "event_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "sample_count",
          "iou",
          "f1_dice",
          "precision",
          "recall",
          "absolute_area_error_ratio",
          "brier_score",
          "expected_calibration_error"
        ],
        "properties": {
          "event_id": { "$ref": "#/$defs/safeId" },
          "sample_count": { "type": "integer", "minimum": 1 },
          "iou": { "$ref": "#/$defs/unitMetric" },
          "f1_dice": { "$ref": "#/$defs/unitMetric" },
          "precision": { "$ref": "#/$defs/unitMetric" },
          "recall": { "$ref": "#/$defs/unitMetric" },
          "absolute_area_error_ratio": {
            "type": "number",
            "minimum": 0
          },
          "brier_score": { "$ref": "#/$defs/unitMetric" },
          "expected_calibration_error": { "$ref": "#/$defs/unitMetric" }
        }
      }
    },
    "error_strata": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "coverage_status",
          "cell_count",
          "false_positive_count",
          "false_negative_count",
          "precision",
          "recall"
        ],
        "properties": {
          "category": { "$ref": "#/$defs/safeId" },
          "coverage_status": { "enum": ["measured", "insufficient", "absent"] },
          "cell_count": { "type": "integer", "minimum": 0 },
          "false_positive_count": { "type": "integer", "minimum": 0 },
          "false_negative_count": { "type": "integer", "minimum": 0 },
          "precision": { "$ref": "#/$defs/nullableUnitMetric" },
          "recall": { "$ref": "#/$defs/nullableUnitMetric" }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "reliability_asset_sha256"],
      "properties": {
        "status": { "enum": ["not_evaluated", "evaluated", "failed"] },
        "method": { "type": ["string", "null"], "minLength": 1 },
        "reliability_asset_sha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "selective_prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "risk_coverage_asset_sha256"],
      "properties": {
        "status": { "enum": ["not_evaluated", "evaluated", "failed"] },
        "risk_coverage_asset_sha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "ood_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "threshold", "score_asset_sha256"],
      "properties": {
        "status": { "enum": ["not_evaluated", "passed", "failed"] },
        "method": { "type": ["string", "null"], "minLength": 1 },
        "threshold": { "type": ["number", "null"] },
        "score_asset_sha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "downstream_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "population_absolute_error",
        "critical_road_false_negative_count",
        "access_classification_flip_count",
        "equity_gap_absolute_error",
        "fpps_mean_absolute_error",
        "fpps_rank_correlation",
        "action_class_flip_count",
        "artifact_sha256"
      ],
      "properties": {
        "status": { "enum": ["not_evaluated", "evaluated", "failed"] },
        "population_absolute_error": { "$ref": "#/$defs/nullableNonnegative" },
        "critical_road_false_negative_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "access_classification_flip_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "equity_gap_absolute_error": { "$ref": "#/$defs/nullableNonnegative" },
        "fpps_mean_absolute_error": { "$ref": "#/$defs/nullableNonnegative" },
        "fpps_rank_correlation": {
          "type": ["number", "null"],
          "minimum": -1,
          "maximum": 1
        },
        "action_class_flip_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "artifact_sha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_seconds",
        "calibration_seconds",
        "inference_seconds",
        "total_seconds",
        "peak_memory_mb",
        "device",
        "hardware_class"
      ],
      "properties": {
        "training_seconds": { "$ref": "#/$defs/nullableNonnegative" },
        "calibration_seconds": { "$ref": "#/$defs/nullableNonnegative" },
        "inference_seconds": { "$ref": "#/$defs/nullableNonnegative" },
        "total_seconds": { "$ref": "#/$defs/nullableNonnegative" },
        "peak_memory_mb": { "$ref": "#/$defs/nullableNonnegative" },
        "device": { "type": ["string", "null"], "minLength": 1 },
        "hardware_class": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "processing_allowed": { "type": "boolean" },
    "can_feed_decision_layer": { "const": false },
    "reason_blocked": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dataset_mode": { "enum": ["fixture_demo", "candidate"] }
        },
        "required": ["dataset_mode"]
      },
      "then": {
        "properties": {
          "operational_status": { "const": "non_operational" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluation_status": { "const": "completed_report_only" }
        },
        "required": ["evaluation_status"]
      },
      "then": {
        "properties": {
          "evaluation_scope": { "const": "final_holdout" },
          "controlled_result_receipt_sha256": { "$ref": "#/$defs/sha256" },
          "reference_evidence": {
            "properties": {
              "reference_mask_sha256": { "$ref": "#/$defs/sha256" },
              "label_release_sha256": { "$ref": "#/$defs/sha256" },
              "reviewer_qualification_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "partition_evidence": {
            "properties": {
              "partition_manifest_sha256": { "$ref": "#/$defs/sha256" },
              "training_partition_sha256": { "$ref": "#/$defs/sha256" },
              "calibration_partition_sha256": { "$ref": "#/$defs/sha256" },
              "final_holdout_partition_sha256": { "$ref": "#/$defs/sha256" }
            }
          },
          "threshold_evidence": {
            "properties": {
              "threshold": { "$ref": "#/$defs/unitMetric" },
              "threshold_selection_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "selection_scope": {
                "const": "verified_calibration_projection_only"
              },
              "final_holdout_evaluated_during_selection": { "const": false }
            }
          },
          "overall_metrics": { "$ref": "#/$defs/completeMetrics" },
          "event_metrics": { "minItems": 1 },
          "error_strata": { "minItems": 1 },
          "calibration": {
            "properties": {
              "status": { "const": "evaluated" },
              "method": { "type": "string", "minLength": 1 },
              "reliability_asset_sha256": { "$ref": "#/$defs/sha256" }
            }
          },
          "selective_prediction": {
            "properties": {
              "status": { "const": "evaluated" },
              "risk_coverage_asset_sha256": { "$ref": "#/$defs/sha256" }
            }
          },
          "ood_evaluation": {
            "properties": {
              "status": { "const": "passed" },
              "method": { "type": "string", "minLength": 1 },
              "threshold": { "type": "number" },
              "score_asset_sha256": { "$ref": "#/$defs/sha256" }
            }
          },
          "downstream_impact": {
            "properties": {
              "status": { "const": "evaluated" },
              "population_absolute_error": { "type": "number", "minimum": 0 },
              "critical_road_false_negative_count": {
                "type": "integer",
                "minimum": 0
              },
              "access_classification_flip_count": {
                "type": "integer",
                "minimum": 0
              },
              "equity_gap_absolute_error": { "type": "number", "minimum": 0 },
              "fpps_mean_absolute_error": { "type": "number", "minimum": 0 },
              "fpps_rank_correlation": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "action_class_flip_count": {
                "type": "integer",
                "minimum": 0
              },
              "artifact_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,40}$"
    },
    "unitMetric": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nullableUnitMetric": {
      "oneOf": [
        { "$ref": "#/$defs/unitMetric" },
        { "type": "null" }
      ]
    },
    "nullableNonnegative": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "true_positive",
        "false_positive",
        "false_negative",
        "true_negative",
        "iou",
        "f1_dice",
        "precision",
        "recall",
        "boundary_f1",
        "signed_area_error_ratio",
        "absolute_area_error_ratio",
        "brier_score",
        "negative_log_likelihood",
        "expected_calibration_error"
      ],
      "properties": {
        "sample_count": { "type": ["integer", "null"], "minimum": 1 },
        "true_positive": { "type": ["integer", "null"], "minimum": 0 },
        "false_positive": { "type": ["integer", "null"], "minimum": 0 },
        "false_negative": { "type": ["integer", "null"], "minimum": 0 },
        "true_negative": { "type": ["integer", "null"], "minimum": 0 },
        "iou": { "$ref": "#/$defs/nullableUnitMetric" },
        "f1_dice": { "$ref": "#/$defs/nullableUnitMetric" },
        "precision": { "$ref": "#/$defs/nullableUnitMetric" },
        "recall": { "$ref": "#/$defs/nullableUnitMetric" },
        "boundary_f1": { "$ref": "#/$defs/nullableUnitMetric" },
        "signed_area_error_ratio": { "type": ["number", "null"] },
        "absolute_area_error_ratio": { "$ref": "#/$defs/nullableNonnegative" },
        "brier_score": { "$ref": "#/$defs/nullableUnitMetric" },
        "negative_log_likelihood": { "$ref": "#/$defs/nullableNonnegative" },
        "expected_calibration_error": { "$ref": "#/$defs/nullableUnitMetric" }
      }
    },
    "completeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "true_positive",
        "false_positive",
        "false_negative",
        "true_negative",
        "iou",
        "f1_dice",
        "precision",
        "recall",
        "boundary_f1",
        "signed_area_error_ratio",
        "absolute_area_error_ratio",
        "brier_score",
        "negative_log_likelihood",
        "expected_calibration_error"
      ],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 1 },
        "true_positive": { "type": "integer", "minimum": 0 },
        "false_positive": { "type": "integer", "minimum": 0 },
        "false_negative": { "type": "integer", "minimum": 0 },
        "true_negative": { "type": "integer", "minimum": 0 },
        "iou": { "$ref": "#/$defs/unitMetric" },
        "f1_dice": { "$ref": "#/$defs/unitMetric" },
        "precision": { "$ref": "#/$defs/unitMetric" },
        "recall": { "$ref": "#/$defs/unitMetric" },
        "boundary_f1": { "$ref": "#/$defs/unitMetric" },
        "signed_area_error_ratio": { "type": "number" },
        "absolute_area_error_ratio": { "type": "number", "minimum": 0 },
        "brier_score": { "$ref": "#/$defs/unitMetric" },
        "negative_log_likelihood": { "type": "number", "minimum": 0 },
        "expected_calibration_error": { "$ref": "#/$defs/unitMetric" }
      }
    }
  }
}
