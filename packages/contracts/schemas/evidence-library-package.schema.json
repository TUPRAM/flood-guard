            "ambiguous_population_cells": {
              "type": "integer",
              "minimum": 0
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "units": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name_th": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "enum": [
                      "full_unit",
                      "partial_unit"
                    ]
                  },
                  "unit_coverage_fraction": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "intersection_area_km2": {
                    "type": "number",
                    "minimum": 0
                  },
                  "population_context": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "modelled_population": {
                            "type": "number",
                            "minimum": 0
                          },
                          "unknown_access_population": {
                            "type": "number",
                            "minimum": 0
                          },
                          "connected_without_route_population": {
                            "type": "number",
                            "minimum": 0
                          },
                          "over_30_minutes_population": {
                            "type": "number",
                            "minimum": 0
                          },
                          "within_30_minutes_population": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "modelled_population",
                          "unknown_access_population",
                          "connected_without_route_population",
                          "over_30_minutes_population",
                          "within_30_minutes_population"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "affected_population": {
                    "type": "null"
                  },
                  "fpps": {
                    "type": "null"
                  },
                  "action_class": {
                    "type": "null"
                  },
                  "interventions": {
                    "type": "array",
