{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodguard.th/contracts/status.schema.json",
  "title": "FloodGuard status response",
  "description": "Application and dataset status. Service health is reported separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_mode",
    "operational_status",
    "source_timestamp",
    "generated_at",
    "confidence_class",
    "source_name",
    "assumptions",
    "official_warning",
    "data_version",
    "git_commit",
    "evidence_context_id",
    "evidence_package_id",
    "study_area",
    "data_state",
    "message_th",
    "message_en"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "dataset_mode": {
      "type": "string",
      "enum": ["fixture_demo", "candidate", "official_input"]
    },
    "operational_status": {
      "type": "string",
      "enum": ["non_operational", "planning_only", "agency_operational"]
    },
    "source_timestamp": { "type": "string", "format": "date-time" },
    "generated_at": { "type": "string", "format": "date-time" },
    "confidence_class": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "source_name": { "type": "string", "minLength": 1 },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "official_warning": { "type": "boolean" },
    "data_version": { "type": "string", "minLength": 1 },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,40}$"
    },
    "evidence_context_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "evidence_package_id": { "type": "string", "minLength": 1 },
    "study_area": { "type": "string", "minLength": 1 },
    "data_state": {
      "type": "string",
      "enum": ["ready", "stale", "blocked", "unavailable"]
    },
    "message_th": { "type": "string", "minLength": 1 },
    "message_en": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dataset_mode": { "enum": ["fixture_demo", "candidate"] }
        },
        "required": ["dataset_mode"]
      },
      "then": {
        "properties": { "official_warning": { "const": false } }
      }
    }
  ]
}
